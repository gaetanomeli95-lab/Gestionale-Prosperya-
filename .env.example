# --- Core ---
ENVIRONMENT=development

# --- PostgreSQL (docker compose up -d db) ---
# These feed docker-compose.yml. Change POSTGRES_PASSWORD for anything non-local.
POSTGRES_USER=prosperya
POSTGRES_PASSWORD=prosperya-dev-only
POSTGRES_DB=prosperya
POSTGRES_PORT=5432

# The application connection string. PostgreSQL is the production target;
# SQLite is a quick local fallback only and is NOT guaranteed to behave
# identically (see docs/TEST_PLAN.md).
DATABASE_URL=postgresql+psycopg://prosperya:prosperya-dev-only@localhost:5432/prosperya
# DATABASE_URL=sqlite:///./dev.db

# --- Auth ---
# Minimum 32 bytes of cryptographic randomness. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES to start in ENVIRONMENT=production with a short/default secret.
JWT_SECRET=change-me-use-32+-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Seed (dev only) ---
SEED_ADMIN_EMAIL=admin@prosperya.it
SEED_ADMIN_PASSWORD=prosperya-admin-dev

# --- Billing issuer (snapshotted on finalized invoices) ---
BILLING_ISSUER_NAME=Prosperya S.r.l.
BILLING_ISSUER_VAT=07415020820
BILLING_ISSUER_TAX_CODE=07415020820
BILLING_ISSUER_ADDRESS=Via Torino, 8
BILLING_ISSUER_CITY=Altavilla Milicia
BILLING_ISSUER_POSTAL_CODE=90010
BILLING_ISSUER_COUNTRY=Italia
BILLING_ISSUER_PEC=

# --- Billing provider secrets (referenced by name from billing_provider_configs) ---
# Example: STUB_WEBHOOK_TOKEN={"webhook_token":"..."}
# STUB_WEBHOOK_TOKEN=
